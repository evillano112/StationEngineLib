#!/usr/bin/env bash
# setup - Cross-platform setup 
# Works on Windows (PowerShell), Linux, macOS

# --- Detect OS ---
OS_TYPE=$(uname)
IS_WINDOWS=false

if [[ "$OS_TYPE" =~ "MINGW" || "$OS_TYPE" =~ "CYGWIN" || "$OS_TYPE" =~ "MSYS" ]]; then
    IS_WINDOWS=true
fi

# --- Colors for bash ---
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
CYAN="\033[0;36m"
NC="\033[0m" # No Color

echo -e "${CYAN}--- Station Engine Setup ---${NC}"

if $IS_WINDOWS; then
    echo -e "${CYAN}Detected Windows. Using PowerShell commands...${NC}"
    
    powershell -Command "
    # Ensure pip is installed
    python -m ensurepip --upgrade;
    python -m pip install --upgrade pip;
    python -m pip install -r requirements.txt;
    "

    # .env handling
    if [ ! -f ".env" ]; then
        if [ -f ".env.example" ]; then
            cp .env.example .env
            echo '.env created from .env.example. Please edit with your DB credentials.'
        else
            echo 'ERROR: .env.example not found.'
            exit 1
        fi
    fi

else
    echo -e "${CYAN}Detected Linux/macOS. Using bash commands...${NC}"

    # Check Python
    if ! command -v python3 &> /dev/null; then
        echo -e "${RED}Python3 is not installed. Please install Python 3.8+ and rerun.${NC}"
        exit 1
    fi

    PYTHON=$(command -v python3)
    echo -e "${GREEN}Found Python at ${PYTHON}${NC}"

    # Install pip packages
    echo -e "${CYAN}Installing required Python packages...${NC}"
    $PYTHON -m pip install --upgrade pip
    $PYTHON -m pip install -r requirements.txt

    # Create .env
    if [ ! -f ".env" ]; then
        if [ -f ".env.example" ]; then
            cp .env.example .env
            echo -e "${GREEN}.env file created from .env.example${NC}"
            echo -e "${YELLOW}Please edit .env and add your database credentials.${NC}"
        else
            echo -e "${RED}ERROR: .env.example file not found.${NC}"
            exit 1
        fi
    else
        echo -e "${GREEN}.env file already exists. Skipping creation.${NC}"
    fi
fi

# --- Verify .env variables ---
REQUIRED_VARS=("DB_HOST" "DB_USER" "DB_PASSWORD" "DB_NAME")
MISSING=()

for var in "${REQUIRED_VARS[@]}"; do
    if ! grep -q "^$var=" ".env"; then
        MISSING+=("$var")
    fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
    echo -e "${YELLOW}WARNING: The following environment variables are missing in .env:${NC}"
    for v in "${MISSING[@]}"; do
        echo "  $v"
    done
else
    echo -e "${GREEN}All required environment variables are present in .env${NC}"
fi

echo -e "\n${CYAN}Setup complete! You can now run:${NC}"
if $IS_WINDOWS; then
    echo -e "${CYAN}python app.py${NC}"
else
    echo -e "${CYAN}python3 app.py${NC}"
fi
